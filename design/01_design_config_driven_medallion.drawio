        <mxCell id="c10" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2A900;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="164" width="5" height="120" as="geometry" />
