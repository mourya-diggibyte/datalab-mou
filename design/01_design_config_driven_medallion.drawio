        <mxCell id="c2" value="&lt;b&gt;STAGE 3 of 4 · RUN · the medallion at runtime + the three execution profiles&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1620" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="The customer_sales_etl pipeline runs serverless on Databricks (environment_version 4). The same artifacts also run off-Databricks for a fast inner loop — with deliberate fidelity gaps noted below." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13.5;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="98" width="1620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Landing volume&lt;/b&gt;&lt;br&gt;&lt;br&gt;/Volumes/&amp;lt;catalog&amp;gt;/​landing/sales/customers/&lt;br&gt;&lt;br&gt;Raw JSON files arrive out-of-band; Auto Loader source." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F1F8;strokeColor=#B7CFE0;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="154" width="240.0" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;bronze.customers_raw&lt;/b&gt;&lt;br&gt;&lt;br&gt;@dp.table (streaming) via cloud_files.&lt;br&gt;&lt;br&gt;Raw ingest, minimal shaping." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="154" width="240.0" height="140" as="geometry" />
