        <mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#000000;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="c7" target="c16">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="c17l" value="error rows" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" connectable="0" parent="c17">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="38" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Execution profiles  —  capability fidelity (datalab.profile)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0E1A20;strokeColor=none;strokeWidth=1;fontColor=#FFFFFF;fontSize=12.5;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="478" width="1620" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;databricks (default)&lt;/b&gt;&lt;br&gt;&lt;br&gt;deploy + run (make deploy / run).&lt;br&gt;&lt;br&gt;• Auto Loader ✓&lt;br&gt;• AUTO CDC ✓&lt;br&gt;• dqx quarantine ✓&lt;br&gt;• delta/kafka sinks ✓&lt;br&gt;&lt;br&gt;&lt;i&gt;Full fidelity — the production path.&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="522" width="520.0" height="218" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#4E7A88;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="532" width="5" height="198" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;local — OSS spark-pipelines&lt;/b&gt;&lt;br&gt;&lt;br&gt;make run-local (generates spark-pipeline.yml).&lt;br&gt;&lt;br&gt;• Materializes bronze → silver → gold as BATCH MVs on sample data&lt;br&gt;• &lt;b&gt;No&lt;/b&gt; AUTO CDC dedup (a window over an in-graph dataset fails graph registration)&lt;br&gt;• &lt;b&gt;No&lt;/b&gt; dqx gate (dqx reads df.columns / df.isStreaming — forbidden in an SDP query fn)&lt;br&gt;• &lt;b&gt;No&lt;/b&gt; Auto Loader / sinks&lt;br&gt;&lt;br&gt;&lt;i&gt;Validates mapping + transform shape only.&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590.0" y="522" width="520.0" height="218" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2A900;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590.0" y="532" width="5" height="198" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;connect — Databricks Connect&lt;/b&gt;&lt;br&gt;&lt;br&gt;make validate-connect.&lt;br&gt;&lt;br&gt;• Runs run_dataset on a LIVE cluster from an isolated, out-of-lock overlay&lt;br&gt;• Validates transforms + dqx against real UC data&lt;br&gt;• Never installed into the dev venv / uv.lock (conflicts with pyspark)&lt;br&gt;&lt;br&gt;&lt;i&gt;CDC / once semantics still verify via a dev refresh.&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140.0" y="522" width="520.0" height="218" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#5A6B7B;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140.0" y="532" width="5" height="198" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;Local OSS pyspark.pipelines lacks Databricks-only symbols (AUTO CDC fns, once, MV refresh_policy); compat.py drops the knobs locally for shape-only inspection. CDC / dqx semantics verify on a dev refresh.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11.5;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="758" width="1620" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="xf-p5" name="5 - SHIP - Deploy + governance">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="640" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="c1" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FF3621;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="54" height="5" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;STAGE 4 of 4 · SHIP · Declarative Automation Bundle, GitHub OIDC CI/CD, RBAC + ABAC&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1620" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="One bundle (databricks.yml + resources/*.yml) deploys the whole domain to dev / stage / prod. CD authenticates with GitHub OIDC — no long-lived Databricks secret in GitHub. Access governance has three layers, each with one home." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13.5;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="98" width="1620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b style=&#x27;font-size:13px;&#x27;&gt;Declarative Automation Bundle&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;tt&gt;databricks.yml&lt;/tt&gt; — variables (catalog / schemas / paths)&lt;br&gt;• &lt;tt&gt;rbac.yml&lt;/tt&gt; — RBAC: group + permission-level string vars + complex pipeline_permissions / job_permissions (per-target overrides)&lt;br&gt;• &lt;tt&gt;projects/*/resources/*.yml&lt;/tt&gt; — 2 SDP pipelines + 3 jobs (refresh / export / quarantine-report)&lt;br&gt;• targets: &lt;b&gt;dev&lt;/b&gt; (mode development — [dev user] prefix, trigger paused) · &lt;b&gt;stage&lt;/b&gt; · &lt;b&gt;prod&lt;/b&gt; (mode production, explicit root_path)&lt;br&gt;• deps: the framework as a versioned wheel from each catalog&#x27;s &lt;tt&gt;artifacts.wheels&lt;/tt&gt; UC Volume (&lt;tt&gt;${var.datalab_wheel}&lt;/tt&gt;) + the domain&#x27;s own &lt;tt&gt;&amp;lt;catalog&amp;gt;_etl&lt;/tt&gt; wheel, never &lt;tt&gt;--editable&lt;/tt&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;make validate before pushing bundle changes.&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="154" width="795.0" height="202" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#4E7A88;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="5" height="182" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b style=&#x27;font-size:13px;&#x27;&gt;GitHub OIDC CI/CD&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;CI&lt;/b&gt; (common-ci-steps): ruff + validate-configs + pytest (local Spark) + bundle validate, plus an advisory spark-pipelines dry-run&lt;br&gt;• &lt;b&gt;CD&lt;/b&gt; (common-cd-steps → deploy-dab): validate + deploy with optional --var overrides&lt;br&gt;• Auth = &lt;b&gt;GitHub OIDC&lt;/b&gt;; the federation subject must match &lt;tt&gt;repo:&amp;lt;owner&amp;gt;/&amp;lt;repo&amp;gt;:environment:&amp;lt;target&amp;gt;&lt;/tt&gt;&lt;br&gt;• Releases: merge to main → dev · tag vX.Y.Z-rcN → stage · tag vX.Y.Z → prod&lt;br&gt;&lt;br&gt;&lt;i&gt;Only STRING variables can be --var-overridden (complex cannot).&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="865.0" y="154" width="795.0" height="202" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#0E1A20;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="865.0" y="164" width="5" height="182" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Layer 1 · Workspace-resource RBAC&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;tt&gt;permissions:&lt;/tt&gt; on every bundle resource, driven by the group + permission-level string vars in &lt;tt&gt;rbac.yml&lt;/tt&gt; (the complex permissions reference them).&lt;br&gt;&lt;br&gt;Both groups AND levels diverge per target (dev demo groups; stage / prod persona groups; prod tightens readers to CAN_VIEW + adds admin_group) and per GitHub Environment (DATALAB_*_GROUP → deploy-dab --var)." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="520.0" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8912A;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="396" width="5" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Layer 2 · Unity Catalog RBAC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Grants-as-code in &lt;tt&gt;scripts/bootstrap_uc.py&lt;/tt&gt; — idempotent catalog / schema / volume DDL + GRANTs, applied once per target with &lt;tt&gt;make bootstrap-uc&lt;/tt&gt;.&lt;br&gt;&lt;br&gt;Deliberately out-of-band of the bundle so &lt;tt&gt;bundle destroy&lt;/tt&gt; never touches governance state. Readers get silver/gold SELECT + export reads; engineers build the medallion." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590.0" y="386" width="520.0" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#9AA0A6;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590.0" y="396" width="5" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Layer 3 · ABAC (display-only)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Column masks + row filters as SQL under the domain&#x27;s &lt;tt&gt;sql/abac/&lt;/tt&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nothing in this repo&lt;/b&gt; (CI, agents, scripts) executes them — an admin reviews and applies them manually.&lt;br&gt;&lt;br&gt;&lt;i&gt;Auto-applying access policy from a code repo is the failure mode this convention prevents.&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140.0" y="386" width="520.0" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FF3621;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140.0" y="396" width="5" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Production-sensitive files (the bundle, dependency manifests, framework core, CI/CD, agent harness, docs-of-record) are guarded; the branch-first protocol (no edits on main) is enforced in both agent harnesses and the git pre-commit hook.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11.5;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="574" width="1620" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
