        <mxCell id="c7" value="&lt;b&gt;silver.customers&lt;/b&gt;&lt;br&gt;&lt;br&gt;create_streaming_table + create_auto_cdc_flow (SCD1).&lt;br&gt;dqx gate keeps valid rows.&lt;br&gt;&lt;br&gt;&lt;i&gt;Upserts without MERGE.&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="154" width="240.0" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#9AA0A6;strokeColor=none;strokeWidth=1;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="164" width="5" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;gold.customers_by_city&lt;/b&gt;&lt;br&gt;&lt;br&gt;@dp.materialized_view.&lt;br&gt;&lt;br&gt;Business-level aggregates for readers / BI / exports." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
