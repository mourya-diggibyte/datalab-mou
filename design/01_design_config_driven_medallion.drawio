        <mxCell id="c16" value="&lt;b&gt;silver.customers_quarantine&lt;/b&gt;&lt;br&gt;&lt;br&gt;dqx error rows + _errors evidence — the dropped rows, exactly." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDEDEB;strokeColor=#F0B9B1;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
