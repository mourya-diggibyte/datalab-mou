        <mxCell id="c11" value="&lt;b&gt;customer_sales_etl_refresh&lt;/b&gt;&lt;br&gt;&lt;br&gt;pipeline_task, daily trigger (paused in dev).&lt;br&gt;&lt;br&gt;Edge jobs read gold; notebook triages quarantine." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;strokeWidth=1;fontColor=#000000;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=10;fontFamily=Helvetica;" vertex="1" parent="1">
