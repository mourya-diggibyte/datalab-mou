# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# isolated output for the framework wheel (make publish-wheel)
dist-framework/

# Virtual envs (uv-managed)
.venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# Secrets and local-only env — never commit
.env
.env.*

# Per-developer agent settings (machine-local, not shared)
.claude/settings.local.json

# Databricks bundle state (auto-generated by the CLI)
.databricks/

# IDE / OS noise
.vscode/
.idea/
.DS_Store

# Local OSS spark-pipelines run artifacts (generated spec + storage/warehouse)
.build/
spark-pipeline.local.yml
spark-warehouse/
metastore_db/
derby.log

# Isolated Databricks Connect venv (kept OUT of uv.lock — see Makefile validate-connect)
.venv-connect/

# Scratch
tmp/
# make design-preview: the diagrams' HTML twin + PNGs, for looking, never committed
.design-preview/
